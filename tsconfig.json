{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "None",
    "strict": true,
    "noUnusedLocals": false,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "rootDir": "src/main/ts",
    "outDir": "src/main/resources/static/js"
  },
  "include": ["src/main/ts/**/*.ts"]
}
